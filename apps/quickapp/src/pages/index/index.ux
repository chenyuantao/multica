<template>
  <div class="root">
    <web
      id="web"
      class="web"
      src="{{webSrc}}"
      trustedurl="{{trustedUrls}}"
      showloadingdialog="true"
      supportzoom="false"
      ontitulereceive="onTitle"
      onpagefinish="onPageFinish"
      onmessage="onWebMessage"
      onerror="onWebError"
    ></web>
  </div>
</template>

<style>
  .root {
    flex-direction: column;
    width: 100%;
    height: 100%;
  }
  .web {
    width: 100%;
    flex-grow: 1;
  }
</style>

<script>
  import storage from '@system.storage'
  import prompt from '@system.prompt'
  import { WEB_ORIGIN, START_PATH } from '../../config.js'

  const REG_ID_KEY = 'oppo_reg_id'
  const PENDING_PATH_KEY = 'pending_path'

  function absolutize(path) {
    if (!path) return WEB_ORIGIN + START_PATH
    if (/^https?:\/\//i.test(path)) return path
    if (path.startsWith('/')) return WEB_ORIGIN + path
    return WEB_ORIGIN + '/' + path
  }

  function hostPattern(origin) {
    try {
      const host = origin.replace(/^https?:\/\//i, '').split('/')[0]
      // Escape dots for trustedurl regex matching.
      return 'https?://' + host.replace(/\./g, '\\.') + '.*'
    } catch (e) {
      return origin + '.*'
    }
  }

  export default {
    private: {
      webSrc: absolutize(START_PATH),
      trustedUrls: [hostPattern(WEB_ORIGIN)],
      lastRegId: ''
    },
    onInit() {
      this.applyPendingPath()
      this.loadRegId()
    },
    onShow() {
      this.applyPendingPath()
      this.pushRegIdToWeb()
    },
    applyPendingPath() {
      storage.get({
        key: PENDING_PATH_KEY,
        success: (data) => {
          const path = (data && data[PENDING_PATH_KEY]) || (typeof data === 'string' ? data : '')
          if (!path) return
          storage.delete({ key: PENDING_PATH_KEY })
          this.webSrc = absolutize(path)
        }
      })
    },
    loadRegId() {
      const fromApp = this.$app && this.$app.$def && this.$app.$def.regId
      if (fromApp) {
        this.lastRegId = fromApp
        return
      }
      storage.get({
        key: REG_ID_KEY,
        success: (data) => {
          const regId = (data && data[REG_ID_KEY]) || (typeof data === 'string' ? data : '')
          if (regId) this.lastRegId = regId
        }
      })
    },
    onPageFinish() {
      this.pushRegIdToWeb()
    },
    onWebMessage(evt) {
      let message
      try {
        message = JSON.parse(evt.message)
      } catch (e) {
        return
      }
      if (!message || typeof message !== 'object') return
      if (message.type === 'ready') {
        this.pushRegIdToWeb()
        return
      }
      if (message.type === 'navigate' && typeof message.path === 'string' && message.path.startsWith('/')) {
        this.webSrc = absolutize(message.path)
      }
    },
    pushRegIdToWeb() {
      const regId = this.lastRegId || (this.$app && this.$app.$def && this.$app.$def.regId) || ''
      if (!regId) return
      this.lastRegId = regId
      const web = this.$element('web')
      if (!web || typeof web.postMessage !== 'function') return
      web.postMessage({
        message: JSON.stringify({ type: 'oppo-push-regid', regId })
      })
    },
    onWebError(evt) {
      prompt.showToast({
        message: (evt && evt.errorMsg) || '页面加载失败'
      })
    },
    onTitle() {},
    onBackPress() {
      const web = this.$element('web')
      if (!web || typeof web.canBack !== 'function') return false
      web.canBack({
        callback: (e) => {
          if (e) {
            web.back()
          } else {
            // Allow the system to leave the Quick App.
            this.$app.exit && this.$app.exit()
          }
        }
      })
      return true
    }
  }
</script>
