{
  "package": "com.multica.quickapp",
  "name": "Multica",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1113,
  "icon": "/Common/logo.png",
  "features": [
    { "name": "system.webview" },
    { "name": "system.router" },
    { "name": "system.prompt" },
    { "name": "system.storage" },
    { "name": "service.push" }
  ],
  "permissions": [
    { "origin": "*" }
  ],
  "config": {
    "logLevel": "log"
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index"
      }
    }
  },
  "display": {
    "titleBar": false,
    "menu": false,
    "fullScreen": false
  }
}
